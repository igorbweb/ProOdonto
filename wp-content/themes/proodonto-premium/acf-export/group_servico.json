                "key": "field_servico_etapas",
                "label": "Etapas",
                "name": "etapas",
                "type": "repeater",
                "layout": "block",
                "button_label": "Adicionar etapa",
                "instructions": "Revisadas pelo Dr. Alisson. Também entram no schema (howPerformed).",
                "sub_fields": [
                    {
                        "key": "field_servico_etapa_titulo",
                        "label": "Etapa",
                        "name": "titulo",
                        "type": "text"
                    },
                    {
                        "key": "field_servico_etapa_descricao",
                        "label": "Descrição",
                        "name": "descricao",
                        "type": "textarea",
                        "rows": 2
                    },
                    {
                        "key": "field_servico_etapa_duracao",
                        "label": "Tempo",
                        "name": "duracao",
                        "type": "text",
                        "instructions": "Ex.: \"Na mesma visita\"."
                    }
                ]
            },
            {
                "key": "field_po_srv_tab_avaliacoes",
                "label": "Avaliações",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_servico_avaliacoes",
                "label": "Avaliação em destaque",
                "name": "avaliacoes",
                "type": "repeater",
