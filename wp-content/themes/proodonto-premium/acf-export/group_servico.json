                        "type": "text",
                        "wrapper": {
                            "width": "50"
                        }
                    },
                    {
                        "key": "field_servico_avaliacao_unidade",
                        "label": "Unidade",
                        "name": "unidade",
                        "type": "text",
                        "wrapper": {
                            "width": "50"
                        }
                    }
                ]
            },
            {
                "key": "field_servico_avaliacoes_link",
                "label": "Link \"Ver todas no Google\"",
                "name": "avaliacoes_link",
                "type": "url"
            },
            {
                "key": "field_po_srv_tab_unidades-e-whatsapp",
                "label": "Unidades e WhatsApp",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_po_srv_srv_unidades_titulo",
                "name": "srv_unidades_titulo",
