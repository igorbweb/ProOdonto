[
    {
        "key": "group_servico",
        "title": "Tratamento — conteúdo da página",
        "position": "acf_after_title",
        "instruction_placement": "label",
        "location": [
            [
                {
                    "param": "post_type",
                    "operator": "==",
                    "value": "servico"
                }
            ]
        ],
        "fields": [
            {
                "key": "field_po_srv_tab_topo",
                "label": "Topo",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_servico_hero_titulo",
                "label": "H1",
                "name": "hero_titulo",
                "type": "text",
                "instructions": "Envolva a palavra de destaque com asteriscos: O que você quer *resolver*? Ela sai em teal, sem itálico. Vazio = título do tratamento. Nunca o nome de uma cidade só."
            },
            {
                "key": "field_servico_hero_lead",
                "label": "Lead",
                "name": "hero_lead",
                "type": "textarea",
                "rows": 2,
                "instructions": "Uma frase, lida em 10 segundos."
            },
            {
                "key": "field_po_srv_srv_selo",
                "name": "srv_selo",
                "label": "Selo",
                "type": "text",
                "placeholder": "Mais procurado · Repor dentes",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_hero_cor",
                "name": "srv_hero_cor",
                "label": "Cor do topo",
                "type": "button_group",
                "choices": {
                    "marinho": "Marinho",
                    "teal": "Teal"
                },
                "default_value": "marinho",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_botao",
                "name": "srv_botao",
                "label": "Botão principal",
                "type": "text",
                "placeholder": "Agendar avaliação de prótese",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_botao_etapas",
                "name": "srv_botao_etapas",
                "label": "Botão secundário (vai às etapas)",
                "type": "text",
                "placeholder": "Como funciona",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_provas",
                "name": "srv_provas",
                "label": "Provas com ✓",
                "type": "repeater",
                "layout": "table",
                "max": 4,
                "button_label": "Adicionar prova",
                "sub_fields": [
                    {
                        "key": "field_po_srv_provas_texto",
                        "name": "texto",
                        "label": "Texto",
                        "type": "text"
                    }
                ]
            },
            {
                "key": "field_po_srv_srv_hero_foto",
                "name": "srv_hero_foto",
                "label": "Foto do topo",
                "type": "image",
                "return_format": "id",
                "preview_size": "medium",
                "instructions": "Paciente sorrindo ou consultório. WebP ≤ 70 KB. Sem foto = bloco marinho.",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_stat_valor",
                "name": "srv_stat_valor",
                "label": "Número sobre a foto",
                "type": "text",
                "placeholder": "+22 mil",
                "wrapper": {
                    "width": 25
                }
            },
            {
                "key": "field_po_srv_srv_stat_rotulo",
                "name": "srv_stat_rotulo",
                "label": "Rótulo do número",
                "type": "text",
                "placeholder": "atendimentos desde 2019",
                "wrapper": {
                    "width": 25
                }
            },
            {
                "key": "field_po_srv_tab_card",
                "label": "Card",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_servico_card_para_quem",
                "label": "Resumo no card",
                "name": "card_para_quem",
                "type": "text",
                "maxlength": 80,
                "instructions": "Uma linha nos cards da Home, unidades e hub (ex.: \"Dentes alinhados e mordida certa\")."
            },
            {
                "key": "field_po_srv_srv_icone",
                "name": "srv_icone",
                "label": "Ícone",
                "type": "select",
                "choices": {
                    "tooth": "Dente (prótese)",
                    "implant": "Implante",
                    "protocol": "Arcada (protocolo)",
                    "ortho": "Aparelho (ortodontia)",
                    "aesthetic": "Brilho (estética)",
                    "spark": "Raios",
                    "adjust": "Ajuste",
                    "info": "Informação",
                    "check": "Confirmado",
                    "clock": "Relógio",
                    "pin": "Local"
                },
                "allow_null": 1,
                "return_format": "value"
            },
            {
                "key": "field_po_srv_msg_card_foto",
                "label": "",
                "name": "",
                "type": "message",
                "message": "A foto do card é a Imagem destacada do tratamento."
            },
            {
                "key": "field_po_srv_tab_o-que-e",
                "label": "O que é",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_servico_resposta_direta",
                "label": "O que é — resposta direta",
                "name": "resposta_direta",
                "type": "textarea",
                "rows": 4,
                "instructions": "40–60 palavras começando pelo nome do tratamento (\"Prótese dentária é…\"). É o trecho que Google e IAs recortam; vira a descrição do schema. Revisão do Dr. Alisson."
            },
            {
                "key": "field_po_srv_srv_oque_foto",
                "name": "srv_oque_foto",
                "label": "Foto ao lado",
                "type": "image",
                "return_format": "id",
                "preview_size": "medium"
            },
            {
                "key": "field_po_srv_tab_para-quem-e",
                "label": "Para quem é",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_po_srv_srv_para_quem_eyebrow",
                "name": "srv_para_quem_eyebrow",
                "label": "Sobretítulo",
                "type": "text",
                "placeholder": "Para quem é",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_para_quem_titulo",
                "name": "srv_para_quem_titulo",
                "label": "Título",
                "type": "text",
                "placeholder": "É para *você* se…",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_servico_para_quem_itens",
                "label": "Itens",
                "name": "para_quem_itens",
                "type": "repeater",
                "layout": "table",
                "button_label": "Adicionar item",
                "sub_fields": [
                    {
                        "key": "field_servico_para_quem_texto",
                        "label": "Item",
                        "name": "texto",
                        "type": "text"
                    },
                    {
                        "key": "field_po_srv_para_quem_icone",
                        "name": "icone",
                        "label": "Ícone",
                        "type": "select",
                        "choices": {
                            "tooth": "Dente (prótese)",
                            "implant": "Implante",
                            "protocol": "Arcada (protocolo)",
                            "ortho": "Aparelho (ortodontia)",
                            "aesthetic": "Brilho (estética)",
                            "spark": "Raios",
                            "adjust": "Ajuste",
                            "info": "Informação",
                            "check": "Confirmado",
                            "clock": "Relógio",
                            "pin": "Local"
                        },
                        "allow_null": 1,
                        "return_format": "value"
                    }
                ]
            },
            {
                "key": "field_servico_pre_requisitos",
                "label": "O que pode vir antes",
                "name": "pre_requisitos",
                "type": "textarea",
                "rows": 3,
                "instructions": "Bloqueado até revisão do Dr. Alisson."
            },
            {
                "key": "field_po_srv_tab_etapas",
                "label": "Etapas",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_po_srv_srv_etapas_eyebrow",
                "name": "srv_etapas_eyebrow",
                "label": "Sobretítulo",
                "type": "text",
                "placeholder": "Etapa por etapa",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_etapas_titulo",
                "name": "srv_etapas_titulo",
                "label": "Título",
                "type": "text",
                "placeholder": "Como funciona *o tratamento*",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_srv_srv_etapas_botao",
                "name": "srv_etapas_botao",
                "label": "Botão",
                "type": "text",
                "placeholder": "Começar pela avaliação"
            },
