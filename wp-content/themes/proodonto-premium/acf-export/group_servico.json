            {
                "key": "field_po_srv_msg_faq_editor",
                "label": "",
                "name": "",
                "type": "message",
                "message": "Se este tratamento já tem FAQ no editor (bloco \"Perguntas Frequentes\"), ele continua valendo e aparece neste lugar."
            },
            {
                "key": "field_po_srv_tab_veja-tambem",
                "label": "Veja também",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_servico_posts_relacionados",
                "label": "Posts do blog relacionados",
                "name": "posts_relacionados",
                "type": "relationship",
                "post_type": [
                    "post"
                ],
                "filters": [
                    "search"
                ],
                "return_format": "id",
                "max": 3,
                "instructions": "Pelo menos um (SEO-07) — e o post deve linkar de volta."
            },
            {
                "key": "field_po_srv_srv_relacionados",
                "name": "srv_relacionados",
                "label": "Outros tratamentos",
                "type": "relationship",
                "post_type": [
                    "servico"
                ],
                "return_format": "id",
                "max": 3,
                "instructions": "Vazio = os próximos tratamentos da lista."
            }
