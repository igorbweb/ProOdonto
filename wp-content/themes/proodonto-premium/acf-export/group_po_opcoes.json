            },
            {
                "key": "field_po_opt_unidades",
                "name": "unidades",
                "label": "Unidades",
                "type": "repeater",
                "layout": "block",
                "collapsed": "field_po_opt_unidades_nome",
                "button_label": "Adicionar unidade",
                "sub_fields": [
                    {
                        "key": "field_po_opt_unidades_nome",
                        "name": "nome",
                        "label": "Cidade",
                        "type": "text",
                        "required": 1,
                        "wrapper": {
                            "width": 25
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_slug",
                        "name": "slug",
                        "label": "Slug",
                        "type": "text",
                        "instructions": "Igual ao endereço da página: aracaju, lagarto, simao-dias.",
                        "wrapper": {
                            "width": 25
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_bairro",
                        "name": "bairro",
                        "label": "Bairro",
                        "type": "text",
                        "wrapper": {
                            "width": 25
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_uf",
                        "name": "uf",
                        "label": "UF",
                        "type": "text",
                        "wrapper": {
                            "width": 10
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_cep",
                        "name": "cep",
                        "label": "CEP",
                        "type": "text",
                        "wrapper": {
                            "width": 15
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_endereco",
                        "name": "endereco",
                        "label": "Rua e número",
                        "type": "text",
                        "wrapper": {
                            "width": 50
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_telefone",
                        "name": "telefone",
                        "label": "Telefone",
                        "type": "text",
                        "instructions": "Vazio = não aparece.",
                        "wrapper": {
                            "width": 50
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_whatsapp_url",
                        "name": "whatsapp_url",
                        "label": "Link do WhatsApp (UpView)",
                        "type": "url",
                        "required": 1,
                        "wrapper": {
                            "width": 50
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_maps_url",
                        "name": "maps_url",
                        "label": "Link \"Como chegar\" (Google Maps)",
                        "type": "url",
                        "wrapper": {
                            "width": 50
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_nota",
                        "name": "nota",
                        "label": "Nota no Google",
                        "type": "text",
                        "placeholder": "5,0",
                        "wrapper": {
                            "width": 20
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_total",
                        "name": "total",
                        "label": "Nº de avaliações",
                        "type": "text",
                        "placeholder": "301",
                        "wrapper": {
                            "width": 20
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_google_url",
                        "name": "google_url",
                        "label": "Perfil no Google",
                        "type": "url",
                        "wrapper": {
                            "width": 60
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_foto",
                        "name": "foto",
                        "label": "Foto da fachada",
                        "type": "image",
                        "return_format": "id",
                        "preview_size": "thumbnail",
                        "wrapper": {
                            "width": 50
                        },
                        "instructions": "Cartões de unidade e \"Outras unidades\". Sem foto = bloco marinho."
                    },
                    {
                        "key": "field_po_opt_unidades_pagina",
                        "name": "pagina",
                        "label": "Página da unidade",
                        "type": "post_object",
                        "post_type": [
                            "page"
                        ],
                        "return_format": "id",
                        "allow_null": 1,
                        "wrapper": {
                            "width": 50
                        }
                    },
                    {
                        "key": "field_po_opt_unidades_horarios",
                        "name": "horarios",
                        "label": "Horários",
                        "type": "repeater",
                        "layout": "table",
                        "button_label": "Adicionar faixa",
                        "instructions": "Dia com intervalo de almoço = duas faixas com o mesmo rótulo (a página junta: \"Seg a sex 8h–13h e 14h–19h\").",
                        "sub_fields": [
                            {
                                "key": "field_po_opt_unidades_horarios_rotulo",
                                "name": "rotulo",
                                "label": "Rótulo",
                                "type": "text",
                                "placeholder": "Segunda a sexta"
                            },
                            {
                                "key": "field_po_opt_unidades_horarios_rotulo_curto",
                                "name": "rotulo_curto",
                                "label": "Rótulo curto",
                                "type": "text",
                                "placeholder": "Seg a sex"
                            },
                            {
                                "key": "field_po_opt_unidades_horarios_dias",
                                "name": "dias",
                                "label": "Dias (schema)",
                                "type": "checkbox",
                                "choices": {
                                    "Mo": "Seg",
                                    "Tu": "Ter",
                                    "We": "Qua",
                                    "Th": "Qui",
                                    "Fr": "Sex",
                                    "Sa": "Sáb",
                                    "Su": "Dom"
                                },
                                "layout": "horizontal",
                                "return_format": "value"
                            },
                            {
                                "key": "field_po_opt_unidades_horarios_abre",
                                "name": "abre",
                                "label": "Abre",
                                "type": "time_picker",
                                "display_format": "H:i",
                                "return_format": "H:i"
                            },
                            {
                                "key": "field_po_opt_unidades_horarios_fecha",
                                "name": "fecha",
                                "label": "Fecha",
                                "type": "time_picker",
                                "display_format": "H:i",
                                "return_format": "H:i"
                            }
                        ]
                    }
                ]
            },
            {
                "key": "field_po_opt_tab_numeros",
                "label": "Números",
