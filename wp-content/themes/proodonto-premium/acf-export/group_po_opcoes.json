[
    {
        "key": "group_po_opcoes",
        "title": "Conteúdo global",
        "style": "seamless",
        "label_placement": "top",
        "location": [
            [
                {
                    "param": "options_page",
                    "operator": "==",
                    "value": "proodonto-opcoes"
                }
            ]
        ],
        "fields": [
            {
                "key": "field_po_opt_tab_marca",
                "label": "Marca",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_po_opt_logo",
                "name": "logo",
                "label": "Logo (fundo claro)",
                "type": "image",
                "return_format": "id",
                "preview_size": "medium",
                "wrapper": {
                    "width": 50
                },
                "instructions": "SVG ou PNG transparente. Sem logo aqui, o cabeçalho usa o Logo do Personalizar."
            },
            {
                "key": "field_po_opt_logo_claro",
                "name": "logo_claro",
                "label": "Logo (fundo marinho, rodapé)",
                "type": "image",
                "return_format": "id",
                "preview_size": "medium",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_opt_nota_resumo",
                "name": "nota_resumo",
                "label": "Nota no Google (resumo)",
                "type": "text",
                "placeholder": "4,9 a 5,0",
                "wrapper": {
                    "width": 33
                }
            },
            {
                "key": "field_po_opt_total_avaliacoes",
                "name": "total_avaliacoes",
                "label": "Total de avaliações",
                "type": "text",
                "placeholder": "+1.190",
                "wrapper": {
                    "width": 33
                }
            },
            {
                "key": "field_po_opt_google_reviews_url",
                "name": "google_reviews_url",
                "label": "Link \"Ler todas no Google\"",
                "type": "url",
                "wrapper": {
                    "width": 34
                }
            },
            {
                "key": "field_po_opt_header_cta_label",
                "name": "header_cta_label",
                "label": "Botão do cabeçalho",
                "type": "text",
                "placeholder": "Agendar avaliação",
                "instructions": "Leva à seção de unidades. Nas páginas de unidade o botão vira \"WhatsApp <cidade>\" automaticamente."
            },
            {
                "key": "field_po_opt_tab_unidades",
                "label": "Unidades",
                "type": "tab",
                "placement": "top"
            },
            {
                "key": "field_po_opt_unidades_eyebrow",
                "name": "unidades_eyebrow",
                "label": "Sobretítulo da seção de unidades",
                "type": "text",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_opt_unidades_titulo",
                "name": "unidades_titulo",
                "label": "Título da seção de unidades",
                "type": "text",
                "instructions": "Envolva a palavra de destaque com asteriscos: O que você quer *resolver*? Ela sai em teal, sem itálico.",
                "wrapper": {
                    "width": 50
                }
            },
            {
                "key": "field_po_opt_msg_unidades",
                "label": "",
                "name": "",
                "type": "message",
